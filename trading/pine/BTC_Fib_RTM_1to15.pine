//@version=5
// =============================================================================
// BTC Fib Two-Zone + RTM  |  Chart TF: 1m–15m  |  Bias TF: selectable (default 240)
// =============================================================================
// منطق:
// 1) فیبو دو‌ناحیه روی تایم بالاتر → بایاس بای/سل
// 2) ورود روی تایم چارت با Order Block (RTM) هم‌راستا با بایاس
// 3) استاپ تنگ: چند تیک آن‌سوی OB
// 4) تارگت: 1.618 فیبو موج اول (دو ناحیه روی LTF)
// 5) عبور از ناحیه قبلی → به‌روزرسانی فیبو
// 6) ضعف روی 1.618 → برگشت جهت (سل بعد از بای و برعکس)
// =============================================================================
strategy(
     title              = "BTC Fib+RTM (1-15m)",
     shorttitle         = "FibRTM",
     overlay            = true,
     pyramiding         = 0,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,
     slippage           = 2,
     process_orders_on_close = true,
     max_lines_count    = 50,
     max_labels_count   = 50,
     max_boxes_count    = 20
 )

// ─── Inputs ─────────────────────────────────────────────────────────────────
grpHTF  = "Higher TF Bias (Fib دو ناحیه)"
htfTf   = input.timeframe("240", "تایم فیبو جهت‌دهنده", group = grpHTF,
     tooltip = "برای چارت 1–15 دقیقه معمولاً 60 یا 240 مناسب است")
htfSwing = input.int(5, "Pivot HTF (چپ/راست)", minval = 2, maxval = 20, group = grpHTF)

grpLTF  = "Lower TF (موج اول + RTM)"
ltfSwing = input.int(3, "Pivot LTF (چپ/راست)", minval = 2, maxval = 15, group = grpLTF)
impulseBars = input.int(3, "حداقل کندل ایمپالس بعد از OB", minval = 1, maxval = 10, group = grpLTF)
impulseAtr  = input.float(0.8, "حداقل حرکت ایمپالس × ATR", minval = 0.2, step = 0.1, group = grpLTF)
obLookback  = input.int(30, "جستجوی OB (بار)", minval = 10, maxval = 100, group = grpLTF)
obTouchTol  = input.float(0.15, "تلورانس لمس OB × ATR", minval = 0.0, step = 0.05, group = grpLTF)

grpRisk = "ریسک / تارگت"
slBufferAtr = input.float(0.1, "بافر استاپ RTM × ATR", minval = 0.0, step = 0.05, group = grpRisk,
     tooltip = "استاپ تنگ آن‌سوی کف/سقف Order Block")
fibTpRatio  = input.float(1.618, "تارگت فیبو", minval = 1.0, step = 0.001, group = grpRisk)
fibExtWeak  = input.float(1.618, "سطح ضعف / برگشت", minval = 1.0, step = 0.001, group = grpRisk)
useFib186   = input.bool(true, "نمایش سطح 1.86", group = grpRisk)
rrFallback  = input.float(2.0, "RR جایگزین اگر فیبو نامعتبر", minval = 1.0, step = 0.1, group = grpRisk)

grpWeak = "ضعف روی 1.618"
weakWickAtr = input.float(0.25, "حداقل سایه رد × ATR", minval = 0.05, step = 0.05, group = grpWeak)
allowReverse = input.bool(true, "بعد از ضعف → ورود معکوس", group = grpWeak)

grpVis = "نمایش"
showHtfFib = input.bool(true, "فیبو HTF", group = grpVis)
showLtfFib = input.bool(true, "فیبو LTF موج اول", group = grpVis)
showOb     = input.bool(true, "باکس Order Block", group = grpVis)
showTable  = input.bool(true, "جدول وضعیت", group = grpVis)

// ─── Helpers ─────────────────────────────────────────────────────────────────
atr = ta.atr(14)

f_fib(float a, float b, float r) =>
    a + (b - a) * r

f_pivot_pair(float ph, float pl, int ageH, int ageL, bool preferUp) =>
    // برمی‌گرداند: [leg0, leg1, valid, bullishLeg]
    // bullishLeg: از کف به سقف (بای موج) ؛ bearishLeg: از سقف به کف
    float leg0 = na
    float leg1 = na
    bool  valid = false
    bool  bull  = preferUp
    if not na(ph) and not na(pl)
        if preferUp
            // آخرین ساختار هم‌جهت بایاس: low سپس high
            if ageL >= ageH
                leg0 := pl
                leg1 := ph
                bull := true
                valid := ph > pl
            else
                // high جدیدتر از low → برای سل
                leg0 := ph
                leg1 := pl
                bull := false
                valid := pl < ph
        else
            if ageH >= ageL
                leg0 := ph
                leg1 := pl
                bull := false
                valid := pl < ph
            else
                leg0 := pl
                leg1 := ph
                bull := true
                valid := ph > pl
    [leg0, leg1, valid, bull]

// ─── HTF swings + bias ───────────────────────────────────────────────────────
htfHigh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, htfSwing, htfSwing), barmerge.gaps_off, barmerge.lookahead_off)
htfLow  = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, htfSwing, htfSwing),  barmerge.gaps_off, barmerge.lookahead_off)

var float htfPh = na
var float htfPl = na
var int   htfAgeH = 100000
var int   htfAgeL = 100000

htfAgeH += 1
htfAgeL += 1
if not na(htfHigh)
    htfPh := htfHigh
    htfAgeH := 0
if not na(htfLow)
    htfPl := htfLow
    htfAgeL := 0

// بایاس: ساختار HTF — اگر آخرین pivot مهم‌تر کفِ قدیمی‌تر و سقفِ جدیدتر باشد → بای
var int bias = 0  // 1 buy, -1 sell, 0 flat
if not na(htfPh) and not na(htfPl)
    // موج صعودی دو ناحیه: از Pl به Ph وقتی Ph جدیدتر است
    if htfAgeH < htfAgeL and htfPh > htfPl
        bias := 1
    else if htfAgeL < htfAgeH and htfPl < htfPh
        bias := -1

[htf0, htf1, htfOk, htfBull] = f_pivot_pair(htfPh, htfPl, htfAgeH, htfAgeL, bias >= 0)
htfFib1618 = htfOk ? f_fib(htf0, htf1, fibExtWeak) : na
htfFib186  = htfOk ? f_fib(htf0, htf1, 1.86) : na
htfFib05   = htfOk ? f_fib(htf0, htf1, 0.5) : na
htfFib618  = htfOk ? f_fib(htf0, htf1, 0.618) : na

// ─── LTF swings (موج اول / دو ناحیه) ─────────────────────────────────────────
ph = ta.pivothigh(high, ltfSwing, ltfSwing)
pl = ta.pivotlow(low, ltfSwing, ltfSwing)

var float leg0 = na
var float leg1 = na
var bool  legBull = true
var bool  legValid = false
var int   ageH = 100000
var int   ageL = 100000
var float lastZoneHigh = na
var float lastZoneLow  = na

ageH += 1
ageL += 1
if not na(ph)
    ageH := 0
    lastZoneHigh := ph
if not na(pl)
    ageL := 0
    lastZoneLow := pl

// به‌روزرسانی فیبو وقتی قیمت از ناحیه قبلی بالاتر/پایین‌تر رفت
if not na(leg1) and legBull and high > leg1
    // سقف ناحیه شکسته → نقطه 1 به سقف جدید
    leg1 := high
    legValid := true
if not na(leg1) and not legBull and low < leg1
    leg1 := low
    legValid := true

// ساخت/بازسازی لگ از دو pivot
if not na(ph) or not na(pl)
    preferUp = bias >= 0
    [a0, a1, ok, bull] = f_pivot_pair(
         nz(lastZoneHigh, ph),
         nz(lastZoneLow, pl),
         ageH,
         ageL,
         preferUp
     )
    if ok
        // فقط وقتی لگ جدید معنی‌دار است جایگزین کن
        bool rebuild = na(leg0) or na(leg1) or bull != legBull or math.abs(a1 - leg1) > atr * 0.05
        if rebuild
            leg0 := a0
            leg1 := a1
            legBull := bull
            legValid := true

fib0    = legValid ? leg0 : na
fib1    = legValid ? leg1 : na
fib05   = legValid ? f_fib(leg0, leg1, 0.5) : na
fib618  = legValid ? f_fib(leg0, leg1, 0.618) : na
fib1618 = legValid ? f_fib(leg0, leg1, fibTpRatio) : na
fib186  = legValid ? f_fib(leg0, leg1, 1.86) : na

// عبور از 1.618 و ناحیه روبه‌رو → آماده فیبو دوم / ضعف
passedExt = legValid and (
     (legBull and close > fib1618 and close > leg1) or
     (not legBull and close < fib1618 and close < leg1)
 )

// ضعف روی 1.618: نفوذ و برگشت با سایه
weakSell = legValid and legBull and high >= fib1618 and close < fib1618 and (high - math.max(open, close)) >= weakWickAtr * atr
weakBuy  = legValid and not legBull and low <= fib1618 and close > fib1618 and (math.min(open, close) - low) >= weakWickAtr * atr

// ─── RTM Order Block ─────────────────────────────────────────────────────────
// Bullish OB: آخرین کندل نزولی قبل از ایمپالس صعودی
// Bearish OB: آخرین کندل صعودی قبل از ایمپالس نزولی
var float bullObTop = na
var float bullObBot = na
var int   bullObBar = na
var float bearObTop = na
var float bearObBot = na
var int   bearObBar = na

impulseUp = close > open and (close - open) >= impulseAtr * atr * 0.5 and (high - low) >= impulseAtr * atr * 0.35
impulseDn = close < open and (open - close) >= impulseAtr * atr * 0.5 and (high - low) >= impulseAtr * atr * 0.35

// تشخیص OB در lookback وقتی ایمپالس رخ می‌دهد
if impulseUp
    float sumMove = 0.0
    for i = 0 to impulseBars - 1
        sumMove += close[i] - open[i]
    if sumMove > impulseAtr * atr
        for j = 1 to obLookback
            if close[j] < open[j]
                // اولین (نزدیک‌ترین) کندل نزولی قبل از رالی
                bullObTop := math.max(open[j], close[j])
                bullObBot := low[j]
                bullObBar := bar_index - j
                break

if impulseDn
    float sumMove = 0.0
    for i = 0 to impulseBars - 1
        sumMove += open[i] - close[i]
    if sumMove > impulseAtr * atr
        for j = 1 to obLookback
            if close[j] > open[j]
                bearObTop := high[j]
                bearObBot := math.min(open[j], close[j])
                bearObBar := bar_index - j
                break

tol = obTouchTol * atr
inBullOb = not na(bullObTop) and low <= bullObTop + tol and high >= bullObBot - tol
inBearOb = not na(bearObTop) and high >= bearObBot - tol and low <= bearObTop + tol

confirmBuy  = inBullOb and close > open and close >= bullObTop
confirmSell = inBearOb and close < open and close <= bearObBot

// ─── Entries / Exits ─────────────────────────────────────────────────────────
longCond  = bias == 1 and confirmBuy and legValid and legBull and strategy.position_size == 0
shortCond = bias == -1 and confirmSell and legValid and not legBull and strategy.position_size == 0

// معکوس روی ضعف 1.618
revShort = allowReverse and weakSell and strategy.position_size >= 0
revLong  = allowReverse and weakBuy and strategy.position_size <= 0

longSlNow  = not na(bullObBot) ? bullObBot - slBufferAtr * atr : low - slBufferAtr * atr
shortSlNow = not na(bearObTop) ? bearObTop + slBufferAtr * atr : high + slBufferAtr * atr

var float entrySl = na
var float entryTp = na

if longCond
    entrySl := longSlNow
    entryTp := not na(fib1618) ? fib1618 : close + rrFallback * (close - longSlNow)
    strategy.entry("Long RTM", strategy.long)
    strategy.exit("L-Exit", from_entry = "Long RTM", stop = entrySl, limit = entryTp)

if shortCond
    entrySl := shortSlNow
    entryTp := not na(fib1618) ? fib1618 : close - rrFallback * (shortSlNow - close)
    strategy.entry("Short RTM", strategy.short)
    strategy.exit("S-Exit", from_entry = "Short RTM", stop = entrySl, limit = entryTp)

if revShort and not shortCond
    strategy.close("Long RTM", comment = "Weak 1.618")
    entrySl := high + slBufferAtr * atr
    entryTp := legValid ? leg0 : close - rrFallback * (entrySl - close)
    strategy.entry("Short Weak", strategy.short)
    strategy.exit("SW-Exit", from_entry = "Short Weak", stop = entrySl, limit = entryTp)

if revLong and not longCond
    strategy.close("Short RTM", comment = "Weak 1.618")
    entrySl := low - slBufferAtr * atr
    entryTp := legValid ? leg0 : close + rrFallback * (close - entrySl)
    strategy.entry("Long Weak", strategy.long)
    strategy.exit("LW-Exit", from_entry = "Long Weak", stop = entrySl, limit = entryTp)

// گسترش فیبو: فقط تارگت را جلو ببر (استاپ قفل می‌ماند)
if strategy.position_size > 0 and legValid and legBull and not na(fib1618) and not na(entrySl)
    if fib1618 > nz(entryTp, fib1618)
        entryTp := fib1618
    strategy.exit("L-Exit", from_entry = "Long RTM", stop = entrySl, limit = entryTp)
if strategy.position_size < 0 and legValid and not legBull and not na(fib1618) and not na(entrySl)
    if fib1618 < nz(entryTp, fib1618)
        entryTp := fib1618
    strategy.exit("S-Exit", from_entry = "Short RTM", stop = entrySl, limit = entryTp)

// ─── Visuals ─────────────────────────────────────────────────────────────────
var line h0 = na
var line h1 = na
var line h1618 = na
var line l0 = na
var line l1 = na
var line l1618 = na
var line l186 = na
var box bullBox = na
var box bearBox = na

if barstate.islast
    if showHtfFib and htfOk
        line.delete(h0)
        line.delete(h1)
        line.delete(h1618)
        h0 := line.new(bar_index - 40, htf0, bar_index + 5, htf0, color = color.new(color.gray, 30), style = line.style_dotted, width = 1)
        h1 := line.new(bar_index - 40, htf1, bar_index + 5, htf1, color = color.new(color.gray, 30), style = line.style_dotted, width = 1)
        h1618 := line.new(bar_index - 40, htfFib1618, bar_index + 5, htfFib1618, color = color.new(color.orange, 20), style = line.style_dashed, width = 1)
    if showLtfFib and legValid
        line.delete(l0)
        line.delete(l1)
        line.delete(l1618)
        line.delete(l186)
        l0 := line.new(bar_index - 25, fib0, bar_index + 5, fib0, color = color.teal, width = 1)
        l1 := line.new(bar_index - 25, fib1, bar_index + 5, fib1, color = color.teal, width = 1)
        l1618 := line.new(bar_index - 25, fib1618, bar_index + 5, fib1618, color = color.yellow, width = 2)
        if useFib186
            l186 := line.new(bar_index - 25, fib186, bar_index + 5, fib186, color = color.new(color.yellow, 40), width = 1)
    if showOb
        box.delete(bullBox)
        box.delete(bearBox)
        if not na(bullObTop)
            bullBox := box.new(math.max(0, nz(bullObBar, bar_index) ), bullObTop, bar_index + 3, bullObBot, bgcolor = color.new(color.green, 85), border_color = color.new(color.green, 50))
        if not na(bearObTop)
            bearBox := box.new(math.max(0, nz(bearObBar, bar_index) ), bearObTop, bar_index + 3, bearObBot, bgcolor = color.new(color.red, 85), border_color = color.new(color.red, 50))

plotshape(longCond, title = "Buy", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small, text = "RTM B")
plotshape(shortCond, title = "Sell", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, text = "RTM S")
plotshape(weakSell, title = "Weak→Sell", style = shape.circle, location = location.abovebar, color = color.orange, size = size.tiny)
plotshape(weakBuy, title = "Weak→Buy", style = shape.circle, location = location.belowbar, color = color.aqua, size = size.tiny)

if showTable
    var table t = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 70), border_width = 1)
    if barstate.islast
        table.cell(t, 0, 0, "Bias HTF", text_color = color.white, text_size = size.small)
        table.cell(t, 1, 0, bias == 1 ? "BUY" : bias == -1 ? "SELL" : "FLAT", text_color = bias == 1 ? color.lime : bias == -1 ? color.red : color.gray, text_size = size.small)
        table.cell(t, 0, 1, "LTF Fib 0", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 1, str.tostring(fib0, format.mintick), text_color = color.white, text_size = size.small)
        table.cell(t, 0, 2, "LTF Fib 1", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 2, str.tostring(fib1, format.mintick), text_color = color.white, text_size = size.small)
        table.cell(t, 0, 3, "TP 1.618", text_color = color.yellow, text_size = size.small)
        table.cell(t, 1, 3, str.tostring(fib1618, format.mintick), text_color = color.yellow, text_size = size.small)
        table.cell(t, 0, 4, "Passed Ext", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 4, passedExt ? "YES" : "no", text_color = passedExt ? color.orange : color.gray, text_size = size.small)
        table.cell(t, 0, 5, "Bull OB", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 5, not na(bullObTop) ? str.tostring(bullObBot, format.mintick) + "-" + str.tostring(bullObTop, format.mintick) : "—", text_color = color.lime, text_size = size.small)
        table.cell(t, 0, 6, "Bear OB", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 6, not na(bearObTop) ? str.tostring(bearObBot, format.mintick) + "-" + str.tostring(bearObTop, format.mintick) : "—", text_color = color.red, text_size = size.small)
        table.cell(t, 0, 7, "Chart", text_color = color.gray, text_size = size.small)
        table.cell(t, 1, 7, timeframe.period + " | HTF " + htfTf, text_color = color.white, text_size = size.small)

// هشدارها برای اتوماسیون بعدی
alertcondition(longCond, title = "RTM Long", message = "FibRTM LONG {{ticker}} @ {{close}}")
alertcondition(shortCond, title = "RTM Short", message = "FibRTM SHORT {{ticker}} @ {{close}}")
alertcondition(weakSell, title = "Weak 1.618 Sell", message = "FibRTM WEAK→SELL {{ticker}} @ {{close}}")
alertcondition(weakBuy, title = "Weak 1.618 Buy", message = "FibRTM WEAK→BUY {{ticker}} @ {{close}}")
